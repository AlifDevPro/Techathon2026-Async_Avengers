# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Channel ID for proactive alert messages (bonus feature)
# Right-click channel in Discord → Copy Channel ID (enable Developer Mode)
DISCORD_ALERT_CHANNEL_ID=your_alert_channel_id_here

# API Configuration (dashboard backend — single source of truth)
# Local dev: http://localhost:3000
# Docker: leave as http://127.0.0.1:3000 (set automatically in container)
API_BASE_URL=http://localhost:3000

# Groq LLM (humanized bot responses)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# How often the bot polls /api/alerts (ms). Use 30000 for demo = every 30s
ALERT_POLL_INTERVAL_MS=30000

# Demo/testing: fire "all devices on too long" after 30 real seconds (not 2 sim hours)
# Remove or comment out for production/hackathon submission default
CONTINUOUS_ON_THRESHOLD_SEC=30
